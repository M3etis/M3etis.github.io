---
/**
 * Illustration of the ONK 2.0 admin review screen (not a screenshot).
 * Documented behaviour (docs/ai-module.md): the model returns a draft finding with a requirement and
 * a deadline, the cited norm must match a knowledge-base fragment, and only what the administrator
 * accepts or edits reaches the order. The prompt name is from the docs; the model shown is the target
 * choice for production (open weights, strong Russian and Kazakh, long context), not the 7B used in tests.
 *
 * With JS the card plays the flow in a loop (src/scripts/sequence.ts): 0 analysing → 1 draft →
 * 2 checking the quote → 3 quote matches → 4 pointer moves to Accept → 5 click → 6 accepted → 7 reset.
 * Without JS or with reduced motion there is no data-phase and the card shows the static draft.
 */
import type { Lang } from '../../i18n/utils';
import Icon from '../Icon.astro';

interface Props {
  lang: Lang;
  label: string;
}

const { lang, label } = Astro.props;
const c = {
  ru: {
    analysing: 'Анализ визита',
    tag: 'Черновик ИИ',
    done: 'В предписании',
    title: 'Находка',
    finding: 'В помещении не обеспечен доступ к питьевой воде.',
    source: 'Основание из базы знаний',
    quote: '«…обеспечивается доступ к питьевой воде…»',
    checking: 'Сверяю цитату с базой знаний',
    match: 'Цитата совпадает с фрагментом',
    req: 'Требование',
    reqV: 'Обеспечить доступ к питьевой воде',
    due: 'Срок',
    dueV: '30 дней',
    accept: 'Принять',
    accepted: 'Принято',
    edit: 'Исправить',
    reject: 'Отклонить',
  },
  en: {
    analysing: 'Analysing visit',
    tag: 'AI draft',
    done: 'Added to order',
    title: 'Finding',
    finding: 'The room has no access to drinking water.',
    source: 'Grounds from the knowledge base',
    quote: '“…access to drinking water is provided…”',
    checking: 'Checking the quote against the knowledge base',
    match: 'Quote matches the fragment',
    req: 'Requirement',
    reqV: 'Provide access to drinking water',
    due: 'Deadline',
    dueV: '30 days',
    accept: 'Accept',
    accepted: 'Accepted',
    edit: 'Edit',
    reject: 'Reject',
  },
}[lang];
---

<figure class="pv" aria-label={label}>
  <div class="pv__win" aria-hidden="true" data-onk-demo>
    <div class="pv__head">
      <span class="pv__title">{c.title}</span>
      <span class="pv__tag">
        <span class="pv__tag-a"><i class="pv__dot"></i>{c.analysing}</span>
        <span class="pv__tag-b">{c.tag}</span>
        <span class="pv__tag-c"><Icon name="check" size="0.8rem" />{c.done}</span>
      </span>
    </div>

    <div class="pv__finding">
      <p class="pv__finding-text">{c.finding}</p>
      <span class="pv__skel"><i></i><i></i></span>
    </div>

    <div class="pv__source">
      <p class="pv__label"><Icon name="book-open" size="0.85rem" />{c.source}</p>
      <blockquote><span>{c.quote}</span></blockquote>
      <p class="pv__check">
        <span class="pv__check-a"><i class="pv__spin"></i>{c.checking}</span>
        <span class="pv__check-b"><Icon name="check" size="0.8rem" />{c.match}</span>
      </p>
    </div>

    <dl class="pv__fields">
      <div><dt>{c.req}</dt><dd>{c.reqV}</dd></div>
      <div><dt>{c.due}</dt><dd>{c.dueV}</dd></div>
    </dl>

    <div class="pv__actions">
      <span class="pv__btn pv__btn--yes">
        <span class="pv__btn-a">{c.accept}</span>
        <span class="pv__btn-b"><Icon name="check" size="0.85rem" />{c.accepted}</span>
        <svg class="pv__cursor" viewBox="0 0 16 20" width="16" height="20">
          <path d="M1 1v15.5l4.2-4.1 2.9 6.6 2.6-1.1-2.9-6.5H14z" fill="#fff" stroke="#000" stroke-width="1.2" stroke-linejoin="round"></path>
        </svg>
      </span>
      <span class="pv__btn pv__btn--other">{c.edit}</span>
      <span class="pv__btn pv__btn--ghost">{c.reject}</span>
    </div>

    <p class="pv__meta mono">Qwen3-235B-A22B · visit-analysis.v2</p>
  </div>
  <figcaption class="pv__cap">{label}</figcaption>
</figure>

<script>
  import { sequence } from '../../scripts/sequence';

  document.querySelectorAll<HTMLElement>('[data-onk-demo]').forEach((el) => {
    // analysing, draft, checking, matched, pointer, click, accepted, reset
    sequence(el, [1700, 900, 1200, 1300, 1000, 350, 2600, 550]);
  });
</script>

<style>
  .pv {
    margin: 0;
  }

  .pv__win {
    display: grid;
    gap: var(--space-4);
    padding: var(--space-5);
    border-radius: var(--radius-lg);
    background: var(--color-bg);
    box-shadow: 0 0 0 1px var(--color-border);
    font-size: var(--text-small);
    overflow: hidden;
  }

  .pv__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
  }

  .pv__title {
    color: var(--color-text-muted);
    font-size: var(--text-caption);
    font-weight: var(--weight-semibold);
  }

  /* Stacked layers share one grid cell, so swapping them never moves the layout. */
  .pv__tag,
  .pv__finding,
  .pv__check,
  .pv__btn {
    display: inline-grid;
  }

  .pv__tag > *,
  .pv__finding > *,
  .pv__check > *,
  .pv__btn > span {
    grid-area: 1 / 1;
  }

  .pv__tag {
    justify-items: end;
    font-size: var(--text-caption);
    font-weight: var(--weight-semibold);
  }

  .pv__tag > span {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.15rem 0.55rem;
    border-radius: var(--radius-full);
    white-space: nowrap;
  }

  .pv__tag-a {
    background: var(--color-accent-soft);
    color: var(--color-accent);
  }

  .pv__tag-b {
    background: color-mix(in srgb, var(--color-warning) 18%, transparent);
    color: var(--color-warning);
  }

  .pv__tag-c {
    background: color-mix(in srgb, var(--color-success) 18%, transparent);
    color: var(--color-success);
  }

  .pv__dot {
    width: 0.4rem;
    height: 0.4rem;
    border-radius: 50%;
    background: currentColor;
  }

  .pv__finding {
    display: grid;
  }

  .pv__finding-text {
    font-size: var(--text-body);
    font-weight: var(--weight-semibold);
    line-height: 1.35;
  }

  .pv__skel {
    display: grid;
    align-content: center;
    gap: 0.55rem;
  }

  .pv__skel i {
    display: block;
    height: 0.6rem;
    border-radius: 0.3rem;
    background: linear-gradient(90deg, var(--color-surface-2) 30%, var(--color-border-strong) 50%, var(--color-surface-2) 70%) 0 0 / 300% 100%;
  }

  .pv__skel i:last-child {
    width: 60%;
  }

  .pv__source {
    display: grid;
    gap: var(--space-2);
    padding: var(--space-3) var(--space-4);
    border-radius: var(--radius-md);
    background: var(--color-surface);
  }

  .pv__label,
  .pv__check > span {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.35rem;
    font-size: var(--text-caption);
  }

  .pv__label {
    color: var(--color-text-muted);
  }

  .pv__source blockquote {
    margin: 0;
    color: var(--color-text);
    font-style: italic;
  }

  .pv__source blockquote span {
    padding: 0 0.1em;
    border-radius: 0.2em;
    background: linear-gradient(color-mix(in srgb, var(--color-accent) 28%, transparent) 0 0) no-repeat 0 0 / 0% 100%;
    box-decoration-break: clone;
    -webkit-box-decoration-break: clone;
  }

  .pv__check-a {
    color: var(--color-text-muted);
  }

  .pv__check-b {
    color: var(--color-success);
    font-weight: var(--weight-semibold);
  }

  .pv__spin {
    width: 0.75rem;
    height: 0.75rem;
    border: 2px solid var(--color-border-strong);
    border-top-color: var(--color-accent);
    border-radius: 50%;
  }

  .pv__fields {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: var(--space-4);
    margin: 0;
  }

  .pv__fields dt {
    color: var(--color-text-subtle);
    font-size: var(--text-caption);
  }

  .pv__fields dd {
    margin: 2px 0 0;
  }

  .pv__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .pv__btn {
    position: relative;
    padding: 0.5rem 0.9rem;
    border-radius: var(--radius-md);
    background: var(--color-surface-2);
    font-weight: var(--weight-semibold);
    font-size: var(--text-caption);
  }

  .pv__btn > span {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.3rem;
  }

  .pv__btn--yes {
    background: var(--color-accent-fill);
    color: var(--color-accent-contrast);
  }

  .pv__btn--ghost {
    background: transparent;
    color: var(--color-text-muted);
  }

  .pv__meta {
    color: var(--color-text-subtle);
    font-size: 0.6875rem;
  }

  .pv__cap {
    margin-top: var(--space-3);
    color: var(--color-text-subtle);
    font-size: var(--text-caption);
    text-align: center;
  }

  /* ---------- Static state (no JS / reduced motion): the draft, ready for review ---------- */
  .pv__tag-a,
  .pv__tag-c,
  .pv__skel,
  .pv__check-a,
  .pv__btn-b,
  .pv__cursor {
    opacity: 0;
  }

  .pv__cursor {
    position: absolute;
    left: 58%;
    top: 55%;
    filter: drop-shadow(0 2px 4px rgb(0 0 0 / 0.5));
    pointer-events: none;
  }

  /* ---------- Demo phases (set by sequence.ts) ---------- */
  [data-phase] :is(.pv__tag > span, .pv__finding > *, .pv__check > span, .pv__btn > span) {
    transition:
      opacity 380ms var(--ease-out),
      transform 520ms var(--ease-expo);
  }

  [data-phase] :is(.pv__source, .pv__fields, .pv__actions) {
    transition:
      opacity 500ms var(--ease-out),
      transform 600ms var(--ease-expo);
  }

  [data-phase] .pv__btn {
    transition:
      background-color 300ms var(--ease-out),
      color 300ms var(--ease-out),
      opacity 400ms var(--ease-out),
      transform 160ms var(--ease-out);
  }

  [data-phase] .pv__source blockquote span {
    transition: background-size 700ms var(--ease-out) 150ms;
  }

  [data-phase] > * {
    transition: opacity 450ms var(--ease-out);
  }

  /* 0 — the model is reading the visit: skeleton, pulsing status, the rest is still empty */
  [data-phase='0'] .pv__tag-a,
  [data-phase='0'] .pv__skel {
    opacity: 1;
  }

  [data-phase='0'] :is(.pv__tag-b, .pv__finding-text) {
    opacity: 0;
  }

  [data-phase='0'] .pv__finding-text {
    transform: translateY(6px);
  }

  [data-phase='0'] .pv__dot {
    animation: pv-pulse 1s ease-in-out infinite;
  }

  [data-phase='0'] .pv__skel i {
    animation: pv-shimmer 1.4s linear infinite;
  }

  /* the grounds panel waits as an empty, shimmering placeholder; fields and actions are not there yet */
  :is([data-phase='0'], [data-phase='1']) :is(.pv__fields, .pv__actions) {
    opacity: 0;
    transform: translateY(10px);
  }

  [data-phase] .pv__source > * {
    transition: opacity 400ms var(--ease-out);
  }

  :is([data-phase='0'], [data-phase='1']) .pv__source > * {
    opacity: 0;
  }

  :is([data-phase='0'], [data-phase='1']) .pv__source {
    background: linear-gradient(90deg, var(--color-surface) 30%, var(--color-surface-2) 50%, var(--color-surface) 70%) 0 0 / 300% 100%;
    animation: pv-shimmer 1.6s linear infinite;
  }

  /* 2 — the quote is highlighted and checked against the knowledge base */
  [data-phase='2'] .pv__check-a {
    opacity: 1;
  }

  [data-phase='2'] .pv__check-b {
    opacity: 0;
  }

  [data-phase='2'] .pv__spin {
    animation: pv-spin 0.8s linear infinite;
  }

  [data-phase='2'] :is(.pv__fields, .pv__actions) {
    opacity: 0;
    transform: translateY(10px);
  }

  :is([data-phase='2'], [data-phase='3'], [data-phase='4'], [data-phase='5'], [data-phase='6'])
    .pv__source
    blockquote
    span {
    background-size: 100% 100%;
  }

  [data-phase='3'] .pv__check-b svg {
    animation: pv-pop 420ms var(--ease-spring);
  }

  /* 3 → 4 — the pointer comes in and lands on Accept, 5 — click */
  .pv__cursor {
    transform: translate(9rem, 3.5rem);
    transition:
      transform 900ms var(--ease-expo),
      opacity 300ms var(--ease-out);
  }

  :is([data-phase='4'], [data-phase='5'], [data-phase='6']) .pv__cursor {
    opacity: 1;
    transform: none;
  }

  [data-phase='5'] .pv__cursor {
    transform: scale(0.82);
  }

  [data-phase='5'] .pv__btn--yes {
    transform: scale(0.95);
  }

  /* 6 — accepted: the finding goes into the order */
  [data-phase='6'] .pv__tag-b,
  [data-phase='6'] .pv__btn-a {
    opacity: 0;
  }

  [data-phase='6'] .pv__tag-c,
  [data-phase='6'] .pv__btn-b {
    opacity: 1;
  }

  [data-phase='6'] .pv__btn--yes {
    background: color-mix(in srgb, var(--color-success) 22%, transparent);
    color: var(--color-success);
  }

  [data-phase='6'] :is(.pv__btn--other, .pv__btn--ghost) {
    opacity: 0.35;
  }

  [data-phase='6'] .pv__cursor {
    opacity: 0;
    transition-delay: 0ms, 900ms;
  }

  /* 7 — fade out before the next round */
  [data-phase='7'] > * {
    opacity: 0;
  }

  @keyframes pv-pulse {
    50% {
      opacity: 0.3;
    }
  }

  @keyframes pv-shimmer {
    to {
      background-position: -150% 0;
    }
  }

  @keyframes pv-spin {
    to {
      transform: rotate(1turn);
    }
  }

  @keyframes pv-pop {
    from {
      transform: scale(0.3);
    }
  }
</style>
