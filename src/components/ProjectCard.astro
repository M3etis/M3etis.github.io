---
/**
 * Case study tile: problem → solution with an interface preview, then AI UX, results and stack.
 * Designed for the dark "stage" surface but token-driven, so it works on any surface.
 */
import type { CaseStudy } from '../data/projects';
import type { Lang } from '../i18n/utils';
import { ui } from '../i18n/ui';
import EmptyState from './EmptyState.astro';
import Icon from './Icon.astro';
import SkillChip from './SkillChip.astro';
import Todo from './Todo.astro';
import OnkReviewPreview from './previews/OnkReviewPreview.astro';
import OsaFlowPreview from './previews/OsaFlowPreview.astro';

interface Props {
  project: CaseStudy;
  lang: Lang;
}

const { project: p, lang } = Astro.props;
const t = ui[lang].projects;
const a11y = ui[lang].a11y;
const headingId = `case-${p.id}`;
const linkLabel = { live: t.live, code: t.code, releases: t.releases } as const;
---

<article class="case" aria-labelledby={headingId} data-reveal="card">
  <div class="case__top">
    <div class="case__intro">
      <p class="case__kicker">{p.kicker[lang]}</p>
      <h3 id={headingId} class="case__title">{p.title}</h3>

      <dl class="case__ps">
        <div>
          <dt>{t.problem}</dt>
          <dd>{p.problem[lang]}</dd>
        </div>
        <div>
          <dt>{t.solution}</dt>
          <dd>{p.solution[lang]}</dd>
        </div>
      </dl>

      {
        p.links.length > 0 ? (
          <ul class="case__links" role="list">
            {p.links.map((l, i) => (
              <li>
                <a href={l.href} target="_blank" rel="noopener noreferrer" class:list={['case__link', { 'case__link--primary': i === 0 }]}>
                  {l.kind === 'code' && <Icon name="github" size="1rem" />}
                  {linkLabel[l.kind]}
                  <Icon name="arrow-up-right" size="0.95rem" class="case__link-arrow" />
                  <span class="visually-hidden">
                    {p.title} {a11y.newTab}
                  </span>
                </a>
              </li>
            ))}
          </ul>
        ) : (
          p.isPrivate && <EmptyState icon="lock" title={t.private} text={t.privateNote} compact />
        )
      }
    </div>

    <div class="case__preview">
      <div data-parallax="0.05">
        {p.preview === 'onk-review' && <OnkReviewPreview lang={lang} label={t.preview} />}
        {p.preview === 'osa-chat' && <OsaFlowPreview lang={lang} label={t.flow} />}
      </div>
    </div>
  </div>

  <div class="case__details">
    <section class="case__block case__block--aiux" aria-label={`${t.aiux}: ${p.title}`}>
      <h4>{t.aiux}</h4>
      <ul role="list">
        {p.aiux.map((x) => <li>{x[lang]}</li>)}
      </ul>
    </section>
    <section class="case__block" aria-label={`${t.result}: ${p.title}`}>
      <h4>{t.result}</h4>
      <ul role="list">
        {p.results.map((r) => <li><Todo text={r[lang]} /></li>)}
      </ul>
    </section>
    <section class="case__block" aria-label={`${t.role}, ${t.stack}: ${p.title}`}>
      <h4>{t.role}</h4>
      <p>{p.role[lang]}</p>
      <h4 class="case__stack-title">{t.stack}</h4>
      <ul class="case__stack" role="list">
        {p.stack.map((s) => <li><SkillChip>{s}</SkillChip></li>)}
      </ul>
    </section>
  </div>
</article>

<style>
  .case {
    padding: clamp(var(--space-6), 4vw, var(--space-12));
    border-radius: var(--radius-xl);
    background: var(--color-surface);
    transition:
      transform var(--duration-slow) var(--ease-out),
      box-shadow var(--duration-slow) var(--ease-out),
      opacity var(--duration-enter) var(--ease-out);
  }

  .case:hover {
    box-shadow: var(--shadow-3);
  }

  .case__top {
    display: grid;
    gap: clamp(var(--space-8), 4vw, var(--space-16));
    align-items: center;
  }

  @media (min-width: 60rem) {
    .case__top {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr);
    }
  }

  .case__kicker {
    color: var(--color-accent);
    font-size: var(--text-small);
    font-weight: var(--weight-semibold);
  }

  .case__title {
    margin-top: var(--space-2);
    font-size: var(--text-h1);
    line-height: 1.05;
    letter-spacing: var(--tracking-h1);
  }

  .case__ps {
    display: grid;
    gap: var(--space-4);
    margin: var(--space-6) 0 0;
  }

  .case__ps dt {
    color: var(--color-text-subtle);
    font-size: var(--text-caption);
    font-weight: var(--weight-semibold);
  }

  .case__ps dd {
    margin: var(--space-1) 0 0;
    color: var(--color-text-muted);
  }

  .case__links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-5);
    margin-top: var(--space-8);
  }

  .case__link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: 2.75rem;
    color: var(--color-accent);
    text-decoration: none;
    transition: color var(--duration-base) var(--ease-out);
  }

  .case__link--primary {
    padding-inline: var(--space-5);
    border-radius: var(--radius-full);
    background: var(--color-accent-fill);
    color: var(--color-accent-contrast);
    transition: background-color var(--duration-base) var(--ease-out);
  }

  .case__link--primary:hover {
    background: var(--color-accent-hover);
  }

  .case__link:not(.case__link--primary):hover {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .case :global(.case__link-arrow) {
    transition: transform var(--duration-base) var(--ease-out);
  }

  .case__link:hover :global(.case__link-arrow) {
    transform: translate(2px, -2px);
  }

  .case :global(.empty) {
    margin-top: var(--space-8);
  }

  .case__preview {
    transition: transform var(--duration-slow) var(--ease-out);
  }

  .case:hover .case__preview {
    transform: translateY(-4px);
  }

  .case__details {
    display: grid;
    gap: var(--space-8);
    margin-top: clamp(var(--space-10), 5vw, var(--space-16));
    padding-top: clamp(var(--space-8), 4vw, var(--space-10));
    border-top: 1px solid var(--color-border);
  }

  @media (min-width: 52rem) {
    .case__details {
      grid-template-columns: 1.3fr 1fr 1fr;
      gap: var(--space-10);
    }
  }

  .case__block h4 {
    color: var(--color-text);
    font-size: var(--text-small);
    font-weight: var(--weight-semibold);
    letter-spacing: 0;
  }

  .case__block--aiux h4 {
    color: var(--color-accent);
  }

  .case__block ul {
    display: grid;
    gap: var(--space-2);
    margin-top: var(--space-3);
    color: var(--color-text-muted);
    font-size: var(--text-small);
    line-height: 1.45;
  }

  .case__block li {
    position: relative;
    padding-inline-start: var(--space-4);
  }

  .case__block li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.6em;
    width: 0.3rem;
    height: 0.3rem;
    border-radius: 50%;
    background: var(--color-text-subtle);
  }

  .case__block--aiux li::before {
    background: var(--color-accent);
  }

  .case__block p {
    margin-top: var(--space-3);
    color: var(--color-text-muted);
    font-size: var(--text-small);
  }

  .case__stack-title {
    margin-top: var(--space-6);
  }

  .case__block .case__stack {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .case__block .case__stack li {
    padding: 0;
  }

  .case__block .case__stack li::before {
    content: none;
  }
</style>
