} as const;

export type IconName = keyof typeof outline | keyof typeof brand;

interface Props {
  name: IconName;
  size?: number | string;
  label?: string;
  class?: string;
}

const { name, size = '1.25em', label, class: className } = Astro.props;
const isBrand = name in brand;
const a11y = label
  ? { role: 'img' as const, 'aria-label': label }
  : { 'aria-hidden': 'true' as const, focusable: 'false' as const };
---

{
  isBrand ? (
    <svg class:list={['icon', className]} width={size} height={size} viewBox="0 0 24 24" fill="currentColor" {...a11y}>
      <path d={brand[name as keyof typeof brand]} />
    </svg>
  ) : (
    <svg
      class:list={['icon', className]}
      width={size}
      height={size}
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.75"
      stroke-linecap="round"
      stroke-linejoin="round"
      {...a11y}
      set:html={outline[name as keyof typeof outline]}
    />
  )
}

<style>
  .icon {
    flex-shrink: 0;
    display: inline-block;
    vertical-align: -0.15em;
  }
</style>
