---
import Icon from './Icon.astro';
import { ui } from '../i18n/ui';
import { langFromUrl } from '../i18n/utils';

interface Props {
  href: string;
  external?: boolean;
  /** `inherit` keeps the surrounding text colour (for links inside muted text). */
  tone?: 'accent' | 'inherit';
  class?: string;
  [key: string]: unknown;
}

const { href, external = /^https?:\/\//.test(href), tone = 'accent', class: className, ...rest } = Astro.props;
const t = ui[langFromUrl(Astro.url)];
---

<a
  href={href}
  class:list={['link', `link--${tone}`, className]}
  {...(external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
  {...rest}
>
  <slot />
  {external && (
    <>
      <Icon name="arrow-up-right" size="0.85em" class="link__ext" />
      <span class="visually-hidden">{t.a11y.newTab}</span>
    </>
  )}
</a>

<style>
  .link {
    text-decoration: none;
    text-underline-offset: 0.2em;
    transition: color var(--duration-base) var(--ease-out);
  }

  .link--accent {
    color: var(--color-accent);
  }

  .link--inherit {
    color: inherit;
    text-decoration: underline;
    text-decoration-color: var(--color-border-strong);
  }

  .link:hover {
    text-decoration: underline;
    text-decoration-color: currentColor;
  }

  .link :global(.link__ext) {
    display: inline-block;
    margin-inline-start: 0.1em;
    transition: transform var(--duration-base) var(--ease-out);
  }

  .link:hover :global(.link__ext) {
    transform: translate(2px, -2px);
  }
</style>
