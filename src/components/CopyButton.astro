---
import Icon from './Icon.astro';

interface Props {
  value: string;
  label: string;
  copiedLabel: string;
  class?: string;
}

const { value, label, copiedLabel, class: className } = Astro.props;
---

<button
  type="button"
  class:list={['copy-btn', className]}
  data-copy={value}
  data-copied-label={copiedLabel}
  aria-label={label}
  title={label}
  hidden
>
  <Icon name="copy" size="1.05em" class="copy-btn__idle" />
  <Icon name="check" size="1.05em" class="copy-btn__done" />
  <span class="copy-btn__status" aria-live="polite"></span>
</button>

<script>
  // Progressive enhancement: the button only appears when the Clipboard API exists.
  for (const btn of document.querySelectorAll<HTMLButtonElement>('[data-copy]')) {
    if (!navigator.clipboard) continue;
    btn.hidden = false;
    const status = btn.querySelector('.copy-btn__status');
    let timer: number | undefined;
    btn.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(btn.dataset.copy ?? '');
        btn.dataset.state = 'done';
        if (status) status.textContent = btn.dataset.copiedLabel ?? '';
        clearTimeout(timer);
        timer = window.setTimeout(() => {
          delete btn.dataset.state;
          if (status) status.textContent = '';
        }, 1800);
      } catch {
        /* clipboard blocked — the email is still visible and selectable */
      }
    });
  }
</script>

<style>
  .copy-btn {
    position: relative;
    display: inline-grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border: var(--stroke) solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-surface);
    color: var(--color-text-muted);
    transition:
      color var(--duration-fast) var(--ease-out),
      border-color var(--duration-fast) var(--ease-out);
  }

  .copy-btn > :global(svg) {
    grid-area: 1 / 1;
  }

  .copy-btn:hover {
    color: var(--color-text);
    border-color: var(--color-border-strong);
  }

  .copy-btn :global(.copy-btn__done),
  .copy-btn[data-state='done'] :global(.copy-btn__idle) {
    display: none;
  }

  .copy-btn[data-state='done'] :global(.copy-btn__done) {
    display: block;
    color: var(--color-success);
    animation: pop 380ms var(--ease-spring);
  }

  .copy-btn:active {
    transform: scale(0.92);
  }

  /* Tooltip: the live-region text doubles as a visible confirmation. */
  .copy-btn__status {
    position: absolute;
    bottom: calc(100% + 0.5rem);
    left: 50%;
    padding: 0.25rem 0.5rem;
    border-radius: var(--radius-sm);
    background: var(--color-text);
    color: var(--color-bg);
    font-size: var(--text-micro);
    white-space: nowrap;
    opacity: 0;
    transform: translate(-50%, 4px);
    pointer-events: none;
    transition:
      opacity var(--duration-base) var(--ease-out),
      transform var(--duration-base) var(--ease-spring);
  }

  .copy-btn__status:empty {
    visibility: hidden;
  }

  .copy-btn[data-state='done'] .copy-btn__status {
    opacity: 1;
    transform: translate(-50%, 0);
  }
</style>
