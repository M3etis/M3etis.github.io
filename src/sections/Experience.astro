---
import { Picture } from 'astro:assets';
import portrait from '../assets/portrait.jpg';
import Button from '../components/Button.astro';
import SectionHeader from '../components/SectionHeader.astro';
import Skeleton from '../components/Skeleton.astro';
import TimelineItem from '../components/TimelineItem.astro';
import { earlier, education, formatMonth, jobs, sideProjects } from '../data/experience';
import { site } from '../data/site';
import type { Lang } from '../i18n/utils';
import { ui } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = ui[lang].experience;

const duration = (start: string, end?: string) => {
  const [sy, sm] = start.split('-').map(Number);
  const now = new Date();
  const [ey, em] = end ? end.split('-').map(Number) : [now.getFullYear(), now.getMonth() + 1];
  const months = (ey - sy) * 12 + (em - sm) + 1;
  const y = Math.floor(months / 12);
  const m = months % 12;
  if (lang === 'ru') {
    const plural = (n: number, one: string, few: string, many: string) =>
      n % 10 === 1 && n % 100 !== 11 ? one : [2, 3, 4].includes(n % 10) && ![12, 13, 14].includes(n % 100) ? few : many;
    return [y && `${y} ${plural(y, 'год', 'года', 'лет')}`, m && `${m} ${plural(m, 'месяц', 'месяца', 'месяцев')}`]
      .filter(Boolean)
      .join(' ');
  }
  return [y && `${y} yr${y > 1 ? 's' : ''}`, m && `${m} mo`].filter(Boolean).join(' ');
};
---

<section class="section section--alt" aria-labelledby="experience">
  <div class="container container--text">
    <SectionHeader id="experience" eyebrow={t.eyebrow} title={t.title} />

    <div class="bio" data-reveal>
      <Skeleton class="bio__photo" data-parallax="0.05">
        <Picture
          src={portrait}
          alt={t.photoAlt}
          formats={['avif', 'webp']}
          fallbackFormat="jpg"
          widths={[160, 320, 480]}
          sizes="(min-width: 48rem) 200px, 160px"
          loading="lazy"
          decoding="async"
          class="bio__img"
          data-fade
        />
      </Skeleton>
      <p class="bio__text">{t.bio}</p>
    </div>

    <ol class="timeline" role="list">
      {
        jobs.map((j) => (
          <TimelineItem
            startLabel={formatMonth(j.start, lang)}
            endLabel={j.end ? formatMonth(j.end, lang) : t.present}
            datetimeStart={j.start}
            datetimeEnd={j.end}
            duration={duration(j.start, j.end)}
            role={j.role[lang]}
            org={j.org[lang]}
            place={j.place?.[lang]}
            url={j.url}
            points={j.points.map((p) => p[lang])}
            current={!j.end}
          />
        ))
      }
    </ol>

    <dl class="extra" data-reveal>
      <div>
        <dt>{t.side}</dt>
        <dd>{sideProjects[lang]}</dd>
      </div>
      <div>
        <dt>{t.earlier}</dt>
        <dd>{earlier[lang]}</dd>
      </div>
      <div>
        <dt>{t.education}</dt>
        <dd>{education[lang]}</dd>
      </div>
    </dl>

    <div class="experience__cta" data-reveal>
      <Button href={site.cv[lang]} variant="secondary" icon="download" download>{t.cvCta}</Button>
    </div>
  </div>
</section>

<style>
  .bio {
    display: grid;
    gap: var(--space-6);
    align-items: center;
    margin-bottom: clamp(var(--space-10), 5vw, var(--space-16));
  }

  @media (min-width: 40rem) {
    .bio {
      grid-template-columns: auto 1fr;
      gap: var(--space-10);
    }
  }

  .bio :global(.bio__photo) {
    width: clamp(8.5rem, 16vw, 12.5rem);
    aspect-ratio: 1;
    border-radius: var(--radius-xl);
  }

  .bio :global(picture) {
    height: 100%;
  }

  .bio :global(.bio__img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 30%;
  }

  .bio__text {
    max-width: 36rem;
    font-size: var(--text-lead);
    line-height: 1.45;
    letter-spacing: -0.01em;
  }

  .timeline {
    margin: 0;
  }

  .extra {
    display: grid;
    gap: var(--space-6);
    margin: 0;
    padding-top: var(--space-8);
    border-top: 1px solid var(--color-border);
  }

  @media (min-width: 48rem) {
    .extra > div {
      display: grid;
      grid-template-columns: 11rem 1fr;
      gap: var(--space-10);
    }
  }

  .extra dt {
    font-size: var(--text-small);
    font-weight: var(--weight-semibold);
  }

  .extra dd {
    margin: var(--space-1) 0 0;
    color: var(--color-text-muted);
  }

  .experience__cta {
    margin-top: var(--space-10);
  }
</style>
